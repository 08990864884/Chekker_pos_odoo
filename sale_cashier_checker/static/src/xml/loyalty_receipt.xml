<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sale_cashier_checker.LoyaltyOrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('pos-receipt')]//div[hasclass('before-footer')]" position="inside">
            <t t-if="receipt.cashierCheckerLoyalty &amp;&amp; receipt.cashierCheckerLoyalty.length">
                <div class="cashier-checker-loyalty-receipt">
                    <div>--------------------------------</div>
                    <div class="pos-receipt-center-align pos-receipt-title">LOYALTY POINT</div>
                    <t t-if="receipt.cashierCheckerLoyaltyPartner">
                        <div>
                            Pelanggan
                            <span t-esc="receipt.cashierCheckerLoyaltyPartner"
                                  class="pos-receipt-right-align"/>
                        </div>
                    </t>
                    <t t-foreach="receipt.cashierCheckerLoyalty"
                       t-as="loyalty"
                       t-key="loyalty_index">
                        <div t-esc="loyalty.programName"/>
                        <t t-if="loyalty.won">
                            <div>
                                <t t-esc="loyalty.pointName"/> didapat
                                <span t-esc="loyalty.won" class="pos-receipt-right-align"/>
                            </div>
                        </t>
                        <t t-if="loyalty.spent">
                            <div>
                                <t t-esc="loyalty.pointName"/> dipakai
                                <span t-esc="loyalty.spent" class="pos-receipt-right-align"/>
                            </div>
                        </t>
                        <div>
                            Saldo <t t-esc="loyalty.pointName"/>
                            <span t-esc="loyalty.balance" class="pos-receipt-right-align"/>
                        </div>
                    </t>
                    <br/>
                </div>
            </t>
        </xpath>
    </t>
</templates>

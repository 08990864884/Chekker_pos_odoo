<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sales_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_sales_cashier_manager" model="res.groups">
        <field name="name">Cashier Manager</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('sale_cashier_checker.group_sales_cashier'))]"/>
    </record>

    <record id="group_inventory_checker" model="res.groups">
        <field name="name">Inventory Checker</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>

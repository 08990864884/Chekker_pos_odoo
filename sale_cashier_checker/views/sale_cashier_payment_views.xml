<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_cashier_payment_tree" model="ir.ui.view">
        <field name="name">sale.cashier.payment.tree</field>
        <field name="model">sale.cashier.payment</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'confirmed'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="payment_method"/>
                <field name="pos_order_id" optional="hide"/>
                <field name="cashier_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_cashier_payment_form" model="ir.ui.view">
        <field name="name">sale.cashier.payment.form</field>
        <field name="model">sale.cashier.payment</field>
        <field name="arch" type="xml">
            <form string="Cashier Payment">
                <header>
                    <button name="action_confirm" string="Confirm Payment" type="object"
                            class="oe_highlight" states="draft"
                            groups="sale_cashier_checker.group_sales_cashier"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            attrs="{'invisible': [('state', '=', 'cancel')]}"
                            groups="sale_cashier_checker.group_sales_cashier_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"
                                   domain="[('state', 'in', ('sale', 'done'))]"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_id"/>
                            <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="payment_method" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="reference" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="pos_order_id"
                                   attrs="{'invisible': [('pos_order_id', '=', False)]}"/>
                            <field name="payment_date" readonly="1"/>
                            <field name="cashier_id" attrs="{'invisible': [('cashier_id', '=', False)]}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_cashier_payment" model="ir.actions.act_window">
        <field name="name">Cashier Payments</field>
        <field name="res_model">sale.cashier.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>

    <menuitem id="menu_sale_cashier_payment"
              name="Cashier Payments"
              parent="sale.menu_sale_order"
              action="action_sale_cashier_payment"
              sequence="25"
              groups="sale_cashier_checker.group_sales_cashier"/>
</odoo>

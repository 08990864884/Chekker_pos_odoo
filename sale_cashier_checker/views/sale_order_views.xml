<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_cashier_checker" model="ir.ui.view">
        <field name="name">sale.order.form.cashier.checker</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_cashier"
                        string="Send to Cashier"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', 'not in', ('draft', 'sent'))]}"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_register_cashier_payment"
                        string="Register Payment"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('cashier_state', '!=', 'waiting_payment')]}"
                        groups="sale_cashier_checker.group_sales_cashier"/>
                <field name="cashier_state"
                       widget="statusbar"
                       statusbar_visible="quotation,waiting_payment,paid"
                       attrs="{'invisible': [('state', '=', 'cancel')]}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cashier_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        attrs="{'invisible': [('cashier_payment_count', '=', 0)]}">
                    <field name="cashier_payment_count"
                           widget="statinfo"
                           string="Payments"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="cashier_checker_workflow" invisible="1"/>
                <field name="amount_paid" widget="monetary" readonly="1"
                       attrs="{'invisible': [('state', 'in', ('draft', 'sent'))]}"/>
                <field name="amount_due" widget="monetary" readonly="1"
                       attrs="{'invisible': [('state', 'in', ('draft', 'sent'))]}"/>
                <field name="cashier_payment_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
